<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Reficio</AssemblyName>
    <RootNamespace>Reficio</RootNamespace>
    <Version>1.4.11</Version>
    <NoWarn>NU1903</NoWarn>
  </PropertyGroup>

  <!-- Debug -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Build de prueba sin control de login -->
  <PropertyGroup Condition="'$(Configuration)' == 'TestNoLogin'">
    <DefineConstants>$(DefineConstants);NO_LOGIN</DefineConstants>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\*.png" />
    <AvaloniaResource Include="Resources\*.icns" />
    <AvaloniaResource Include="Resources\icon\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ReficioUpdater\**" />
    <Compile Remove="TestBCrypt\**" />
    <None Remove="ReficioUpdater\**" />
    <None Remove="TestBCrypt\**" />
    <Content Remove="ReficioUpdater\**" />
    <Content Remove="TestBCrypt\**" />
  </ItemGroup>

  <!-- Construye ReficioUpdater y lo embebe como recurso -->
  <Target Name="BuildReficioUpdater" BeforeTargets="CoreCompile">
    <MSBuild Projects="ReficioUpdater\ReficioUpdater.csproj"
             Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=net8.0" />
    
    <!-- Copiar al directorio de salida para ejecución en desarrollo -->
    <Copy SourceFiles="ReficioUpdater\bin\$(Configuration)\net8.0\ReficioUpdater.exe"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('ReficioUpdater\bin\$(Configuration)\net8.0\ReficioUpdater.exe')" />
    <Copy SourceFiles="ReficioUpdater\bin\$(Configuration)\net8.0\ReficioUpdater"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('ReficioUpdater\bin\$(Configuration)\net8.0\ReficioUpdater') AND !Exists('ReficioUpdater\bin\$(Configuration)\net8.0\ReficioUpdater.exe')" />
  </Target>

  <!-- Embeber el actualizador como recurso para distribución single-file -->
  <Target Name="EmbedUpdaterResource" AfterTargets="BuildReficioUpdater" BeforeTargets="CoreCompile">
    <ItemGroup>
      <EmbeddedResource Include="ReficioUpdater\bin\$(Configuration)\net8.0\ReficioUpdater.exe"
                        Condition="Exists('ReficioUpdater\bin\$(Configuration)\net8.0\ReficioUpdater.exe')"
                        LogicalName="ReficioUpdater.exe" />
      <EmbeddedResource Include="ReficioUpdater\bin\$(Configuration)\net8.0\ReficioUpdater"
                        Condition="Exists('ReficioUpdater\bin\$(Configuration)\net8.0\ReficioUpdater') AND !Exists('ReficioUpdater\bin\$(Configuration)\net8.0\ReficioUpdater.exe')"
                        LogicalName="ReficioUpdater" />
    </ItemGroup>
  </Target>

</Project>