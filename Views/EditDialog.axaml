<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Reficio.Views.EditDialog"
        Title="Editar" Width="480" Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F5F6FA">

    <Window.Styles>
        <Style Selector="Button.save">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.save:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Button.cancel">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.cancel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D1D5DB"/>
        </Style>
    </Window.Styles>

    <Border Background="White" CornerRadius="12" Margin="0" Padding="24"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                <Button Content="Guardar" Classes="save" Click="Save_Click" IsDefault="True"/>
                <Button Content="Cancelar" Classes="cancel" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
            <StackPanel x:Name="FieldsPanel" Spacing="4"/>
        </DockPanel>
    </Border>
</Window>
