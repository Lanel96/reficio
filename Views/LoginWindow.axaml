<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Reficio.Views.LoginWindow"
        Title="Reficio — Inicio de Sesión"
        Width="520" Height="360"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#F5F6FA">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E40AF"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>
    </Window.Styles>

    <Border Background="White" CornerRadius="12" Margin="24"
            BorderBrush="#E5E7EB" BorderThickness="1" Padding="28,24">
        <StackPanel Spacing="14">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                <Border Background="#2563EB" CornerRadius="8" Width="38" Height="38">
                    <TextBlock Text="R" FontSize="18" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Reficio" FontSize="18" FontWeight="Bold" Foreground="#1F2937"/>
                    <TextBlock Text="Sistema de Reparación de Bases de Datos" FontSize="11"
                               Foreground="#9CA3AF" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- DB Path -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Base de datos:" Width="90" VerticalAlignment="Center"
                           FontSize="13" Foreground="#374151"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding DbPath}" Watermark="Ruta al archivo .fdb"
                             Margin="0,0,32,0"/>
                    <Button Grid.Column="1" Command="{Binding BrowseCommand}"
                            Width="28" Height="28" Padding="0" CornerRadius="4"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip.Tip="Examinar">
                        <TextBlock Text="&#x1F4C1;" FontSize="16" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Usuario -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Usuario:" Width="90" VerticalAlignment="Center"
                           FontSize="13" Foreground="#374151"/>
                <TextBox Text="{Binding Usuario}" Width="290" Watermark="Usuario MUSUA"/>
            </StackPanel>

            <!-- Contraseña -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Contraseña:" Width="90" VerticalAlignment="Center"
                           FontSize="13" Foreground="#374151"/>
                <TextBox Text="{Binding Password}" Width="290"
                         Watermark="••••••••" PasswordChar="•"/>
            </StackPanel>

            <!-- Status -->
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       FontWeight="SemiBold" Margin="98,0,0,0"
                       Foreground="#DC2626"/>

            <!-- Button -->
            <Button Content="Iniciar Sesión" Classes="primary"
                    Command="{Binding LoginCommand}"
                    HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</Window>
